{
  "name": "rita-tomfordede",
  "version": "1.0.0",
  "description": "Portfolio website for German painter Rita Tomforde - built with Eleventy",
  "main": "eleventy.config.js",
  "scripts": {
    "dev": "npx @11ty/eleventy --serve",
    "build": "npx @11ty/eleventy",
    "build:prod": "ELEVENTY_ENV=production npx @11ty/eleventy",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/css/**/*.css\"",
    "lint:fix": "eslint . --fix",
    "lint:css:fix": "stylelint \"src/css/**/*.css\" --fix",
    "lint:all": "npm run lint && npm run lint:css",
    "format": "prettier --write \"**/*.{js,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,json,md}\""
  },
  "keywords": [
    "eleventy",
    "11ty",
    "portfolio",
    "artist",
    "static-site"
  ],
  "author": "Rita Tomforde",
  "license": "ISC",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.0.0",
    "prettier": "^3.2.0",
    "sharp": "^0.34.5",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  },
  "dependencies": {
    "glightbox": "^3.3.1"
  }
}
