<footer class="site-footer">
    <div class="footer-container">
        <div class="footer-content">
            <div class="footer-contact">
                <h3>Kontakt</h3>
                <p class="contact-name">{{ site.contact.name }}</p>
                <p class="contact-address"><a href="https://maps.google.com/?q={{ (site.contact.address ~ ', ' ~ site.contact.city) | urlencode }}" class="address-link" target="_blank" rel="noopener" aria-label="Öffne {{ site.contact.address }}, {{ site.contact.city }} in Google Maps">{{ site.contact.address }}, {{ site.contact.city }}</a></p>
                <div class="contact-icons">
                    <a href="tel:{{ site.contact.phone | replace(' ', '') }}" class="contact-icon contact-icon--phone" aria-label="Anrufen: {{ site.contact.phone }}">
                        {% include "icons/phone.njk" %}
                    </a>
                    <a href="https://wa.me/49{{ site.contact.whatsapp | replace(' ', '') | replace('0', '', 1) }}" target="_blank" rel="noopener" class="contact-icon contact-icon--whatsapp" aria-label="WhatsApp: {{ site.contact.whatsapp }}">
                        {% include "icons/whatsapp.njk" %}
                    </a>
                    <a href="{{ site.contact.instagram }}" target="_blank" rel="noopener" class="contact-icon contact-icon--instagram" aria-label="Instagram Profil besuchen">
                        {% include "icons/instagram.njk" %}
                    </a>
                </div>
            </div>

            <div class="footer-info">
                <p class="footer-cta">Interessiert an meinen Bildern? Kontaktieren Sie mich gerne.</p>
            </div>
        </div>

        <div class="footer-bottom">
            <p class="copyright">&copy; {{ page.date.getFullYear() if page.date else "2026" }} {{ site.author }}. Alle Rechte vorbehalten.</p>
            <nav class="footer-nav" aria-label="Rechtliche Hinweise">
                <ul>
                    <li><a href="{{ '/impressum/' | url }}">Impressum</a></li>
                    <li><a href="{{ '/datenschutz/' | url }}">Datenschutz</a></li>
                </ul>
            </nav>
        </div>
    </div>
</footer>