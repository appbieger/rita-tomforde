<footer class="site-footer">
    <div class="footer-container">
        <div class="footer-content">
            <div class="footer-contact">
                <h3>Kontakt</h3>
                <p class="contact-name">{{ site.contact.name }}</p>
                <p class="contact-address">{{ site.contact.address }}, {{ site.contact.city }}</p>
                <p class="contact-phone">Tel: <a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a></p>
                <p class="contact-whatsapp">WhatsApp: <a href="https://wa.me/49{{ site.contact.whatsapp | replace(' ', '') | replace('0', '', 1) }}" target="_blank" rel="noopener">{{ site.contact.whatsapp }}</a></p>
                <p class="contact-instagram"><a href="{{ site.contact.instagram }}" target="_blank" rel="noopener">Instagram</a></p>
            </div>

            <div class="footer-info">
                <p class="footer-cta">Interessiert an meinen Bildern? Kontaktieren Sie mich gerne.</p>
            </div>
        </div>

        <div class="footer-bottom">
            <p class="copyright">&copy; {{ page.date.getFullYear() if page.date else "2026" }} {{ site.author }}. Alle Rechte vorbehalten.</p>
            <nav class="footer-nav" aria-label="Rechtliche Hinweise">
                <ul>
                    <li><a href="{{ '/' | url }}#impressum">Impressum</a></li>
                    <li><a href="{{ '/' | url }}#datenschutz">Datenschutz</a></li>
                </ul>
            </nav>
        </div>
    </div>
</footer>
