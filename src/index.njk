{# ============================================================================
   Galerie (Gallery) Section
   ============================================================================ #}
<section id="galerie" class="content-section">
    <div class="container">
        <header class="section-header">
            <h2 class="section-title">Galerie</h2>
        </header>
        <div class="section-content">
            <p class="gallery-intro">Hier zeige ich Ihnen einige meiner aktuell verkäuflichen Bilder. Bei Interesse an einem Original freue ich mich auf Ihre Kontaktaufnahme.</p>

            {% if paintings.paintings.length > 0 %}
            <div class="gallery-grid">
                {% for painting in paintings.paintings %}
                {% if painting.available %}
                <article class="gallery-item" id="{{ painting.id }}">
                    <a href="{{ painting.image | url }}" class="glightbox" data-gallery="paintings" data-title="{{ painting.title }}" data-description="{{ painting.technique }}, {{ painting.year }} , {{ painting.description }} ">
                        {% if painting.image.endsWith('.svg') %}
                        <img src="{{ painting.image | url }}" alt="{{ painting.title }}" loading="lazy" class="gallery-item-image">
                        {% else %}
                        {% image "src" + painting.image, painting.title %}
                        {% endif %}
                    </a>
                    <div class="gallery-item-info">
                        <h3 class="gallery-item-title">{{ painting.title }}</h3>
                       
                    </div>
                </article>
                {% endif %}
                {% endfor %}
            </div>
            {% else %}
            <p class="gallery-empty">Bilder werden bald hinzugefügt.</p>
            {% endif %}

            <div class="gallery-cta">
                <p>Möchten Sie eines meiner Bilder im Original betrachten?</p>
                <p>Ich freue mich auf Ihren Besuch in meinem Atelier in Reith. Bitte kontaktieren Sie mich für einen Termin.</p>
            </div>
        </div>
    </div>
</section>