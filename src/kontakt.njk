---
layout: base.njk
title: Kontakt
permalink: /kontakt/
---

{# ============================================================================
   Kontakt (Contact) Page
   ============================================================================ #}
<section id="kontakt" class="content-section">
    <div class="container">

        <header class="section-header">
            <h1 class="section-title">Kontakt</h1>
        </header>

        <div class="section-content">

            <h2>{{ site.contact.name }}</h2>
            <address>
                {{ site.contact.address }}<br>
                {{ site.contact.city }}
            </address>

            <h2>Kontaktmöglichkeiten</h2>
            <div class="contact-icons">
                <a href="tel:{{ site.contact.phone | replace(' ', '') }}" class="contact-icon contact-icon--phone" aria-label="Anrufen: {{ site.contact.phone }}">
                    {% include "icons/phone.njk" %}
                    <span>{{ site.contact.phone }}</span>
                </a>
                <a href="https://wa.me/49{{ site.contact.whatsapp | replace(' ', '') | replace('0', '', 1) }}" target="_blank" rel="noopener" class="contact-icon contact-icon--whatsapp" aria-label="WhatsApp: {{ site.contact.whatsapp }}">
                    {% include "icons/whatsapp.njk" %}
                    <span>WhatsApp</span>
                </a>
                <a href="{{ site.contact.instagram }}" target="_blank" rel="noopener" class="contact-icon contact-icon--instagram" aria-label="Instagram Profil besuchen">
                    {% include "icons/instagram.njk" %}
                    <span>Instagram</span>
                </a>
                <a href="mailto:{{ site.contact.email }}" class="contact-icon contact-icon--email" aria-label="E-Mail: {{ site.contact.email }}">
                    {% include "icons/email.njk" %}
                    <span>E-Mail</span>
                </a>
            </div>

            <p>Interessiert an meinen Bildern? Kontaktieren Sie mich gerne.</p>

        </div>
    </div>
</section>
